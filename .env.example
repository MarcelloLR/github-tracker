# ---- Database (PostgreSQL) ----
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/github_tracker?schema=public"

# ---- Redis (BullMQ) ----
REDIS_URL="redis://localhost:6379"

# ---- NextAuth / Auth.js ----
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Base URL of the app (used for OAuth callbacks)
AUTH_URL="http://localhost:3000"

# ---- GitHub OAuth App ----
# Create at https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ---- Token encryption (AES-256-GCM) ----
# 32-byte key, base64-encoded. Generate with: openssl rand -base64 32
# Used to encrypt GitHub OAuth access tokens at rest (lib/crypto.ts).
TOKEN_ENCRYPTION_KEY=""

# ---- Anthropic (Claude API) ----
ANTHROPIC_API_KEY=""
# Model overrides (optional — sensible defaults live in lib/anthropic/client.ts)
ANTHROPIC_MODEL_METADATA="claude-haiku-4-5"
ANTHROPIC_MODEL_DEEPDIVE="claude-sonnet-4-6"
ANTHROPIC_MODEL_PROFILE="claude-sonnet-4-6"

# ---- Sync tuning ----
SYNC_INTERVAL_HOURS="3"
# Stop issuing GitHub calls when remaining rate-limit points drop below this floor.
GITHUB_RATE_FLOOR="200"
